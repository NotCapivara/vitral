{
  "manifest_version": 3,
  "name": "Nova Guia Soberana",
  "version": "1.0.0",
  "description": "Nova guia 100% local e personalizável. Sem rastreamento, sem servidores, sem telemetria.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon", "history", "bookmarks", "topSites"],
  "host_permissions": ["https://icons.duckduckgo.com/*", "https://www.wikidata.org/*", "https://query1.finance.yahoo.com/*", "https://query2.finance.yahoo.com/*", "https://api.coingecko.com/*", "https://economia.awesomeapi.com.br/*", "https://api.bcb.gov.br/*"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/star.png", "32": "icons/star.png", "48": "icons/star.png", "128": "icons/star.png"
  }
}
